[3.585, "o", "\r\n"]
[3.645, "o", "examples/bad-message.txt (message) - risk 100/100 [HIGH] - 6 error, 3 warn, 0 info\r\n"]
[3.705, "o", "  1:1   warn  REQ-001  Generic greeting (Dear Sir/Madam)  [0-9]\r\n"]
[3.765, "o", "        found: \"Dear Sir,\"\r\n"]
[3.825, "o", "        why:   Template greetings are the first sign of copy-paste offers, and buyers skip them.\r\n"]
[3.885, "o", "        try:   Use the buyer's name or reference something specific from the request.\r\n"]
[3.945, "o", "  1:11  warn  REQ-003  'I read your request'  [10-44]\r\n"]
[4.005, "o", "        found: \"I have read your request carefully\"\r\n"]
[4.065, "o", "        why:   This opener is pasted into every offer and signals no real reading.\r\n"]
[4.125, "o", "        try:   Prove you read it by quoting a detail or asking one specific question.\r\n"]
[4.185, "o", "  2:1   error OP-006   WhatsApp  [46-68]\r\n"]
[4.245, "o", "        found: \"Contact me on WhatsApp\"\r\n"]
[4.305, "o", "        why:   WhatsApp is the single most-blocked destination for moving a buyer off the platform.\r\n"]
[4.365, "o", "        try:   Remove it; offer to continue in the Fiverr inbox.\r\n"]
[4.425, "o", "  2:24  error OP-004   Phone number  [69-84]\r\n"]
[4.485, "o", "        found: \"+92 300 1234567\"\r\n"]
[4.545, "o", "        why:   Phone numbers (9 to 15 digits, any common formatting) are blocked as off-platform contact details.\r\n"]
[4.605, "o", "        try:   Remove the number.\r\n"]
[4.665, "o", "  2:43  error OP-001   Email address  [88-118]\r\n"]
[4.725, "o", "        found: \"email me at john.doe@gmail.com\"\r\n"]
[4.785, "o", "        why:   Sharing an email address is the most common trigger for the 'keep conversations on Fiverr' block.\r\n"]
[4.845, "o", "        try:   Remove the address and invite the buyer to continue in the Fiverr inbox.\r\n"]
[4.905, "o", "  3:9   error PAY-004  Pay outside / direct payment  [128-143]\r\n"]
[4.965, "o", "        found: \"pay me directly\"\r\n"]
[5.025, "o", "        why:   Asking for payment or tips outside Fiverr is a serious violation and a top reason for restrictions.\r\n"]
[5.085, "o", "        try:   Take every payment, tip included, through Fiverr.\r\n"]
[5.145, "o", "  3:29  error PAY-001  Outside payment service  [148-154]\r\n"]
[5.205, "o", "        found: \"PayPal\"\r\n"]
[5.265, "o", "        why:   Naming an outside payment service is blocked: all payments must go through Fiverr.\r\n"]
[5.325, "o", "        try:   Remove it; the buyer pays through Fiverr checkout.\r\n"]
[5.385, "o", "  3:55  error REV-001  Asking for a 5-star review  [174-198]\r\n"]
[5.445, "o", "        found: \"Leave me a 5 star review\"\r\n"]
[5.505, "o", "        why:   Requesting a specific star rating is review manipulation.\r\n"]
[5.565, "o", "        try:   Ask for honest feedback instead.\r\n"]
[5.625, "o", "  3:85  warn  SEO-010  Excess exclamation marks  [204-206]\r\n"]
[5.685, "o", "        found: \"!!\"\r\n"]
[5.745, "o", "        why:   Stacked exclamation marks read as spam.\r\n"]
[5.805, "o", "        try:   Use one at most.\r\n"]
[5.865, "o", "Hi, I have read your request carefully.\r\n"]
[5.925, "o", "Let's keep everything in Fiverr's inbox so you're protected.\r\n"]
[5.985, "o", "You can order through Fiverr and save the fees. Share your honest feedback after!\r\n"]
[6.785, "o", "\r\n"]
[6.985, "o", "$ "]
